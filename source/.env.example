# MongoDB
MONGODB_URI=mongodb://localhost:27017/tomodachi-shoes

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_master_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# BunnyCDN (alternative to Cloudinary)
BUNNYCDN_STORAGE_ZONE=your_zone
BUNNYCDN_ACCESS_KEY=your_access_key
BUNNYCDN_PULL_ZONE_URL=https://your-zone.b-cdn.net

# Image source directory for batch import
ASSETS_DIR=./assets/images

# Server
PORT=4321

# RapidAPI real-time sneaker prices
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=real-time-sneaker-prices.p.rapidapi.com
